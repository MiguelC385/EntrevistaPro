# Copia este archivo como .env y pon tu clave de Google AI Studio
GEMINI_API_KEY=pon_tu_clave_aqui

# Modelo de Gemini (revisa en aistudio.google.com cuál está disponible en el nivel gratuito)
GEMINI_MODEL=gemini-2.5-flash

# Origenes permitidos para el frontend en desarrollo (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Ruta de la base de datos SQLite
DATABASE_PATH=data.db

# Maximo de solicitudes por minuto por IP
RATE_LIMIT_PER_MINUTE=30
